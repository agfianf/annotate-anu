# API Core Configuration
API_CORE_HOST=0.0.0.0
API_CORE_PORT=8001
API_CORE_DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://annotateanu:annotateanu_dev@postgres:5432/annotateanu
DATABASE_URL_SYNC=postgresql://annotateanu:annotateanu_dev@postgres:5432/annotateanu

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS
CORS_ORIGINS=["http://localhost:18712", "http://localhost:3000"]

# Logging
LOG_LEVEL=INFO

# JWT Authentication
JWT_SECRET_KEY=REPLACE_ME__generate_with__openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# Security
# SECRET_KEY is not only a signing key: services/storage_s3.py derives the Fernet
# key that encrypts stored S3 credentials from it. Rotating it makes every
# previously stored bucket secret undecryptable, so they must be re-entered.
#
# These are placeholders. Put real values in apps/api-core/.env.local, which is
# gitignored and layered on top by docker-compose.override.yml.
SECRET_KEY=REPLACE_ME__generate_with__openssl_rand_hex_32
ENCRYPTION_KEY=REPLACE_ME__generate_with__openssl_rand_hex_32

# External services
SAM3_API_URL=http://backend:8000
MODEL_SERVER_URL=http://model-server:8002
