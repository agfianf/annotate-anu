# API Configuration
VITE_SAM3_API_URL=http://localhost:18710
VITE_CORE_API_URL=http://localhost:18711

# Environment
VITE_ENV=development

# Local model server (Ultralytics/YOLO .pt weights). The browser never talks to it
# directly: api-core proxies it at /api/v1/model-server. This URL is the one api-core
# dials, so it stays a compose service name.
VITE_MODEL_SERVER_INTERNAL_URL=http://model-server:8002
